# Regras do servidor (HostGator) para a pasta do app: wiapps.com.br/wigo
# Publicado junto com o app; vale também para a pasta painel/.

# arquivos de controle da publicação: não ficam abertos na internet
<FilesMatch "^\.(wigo-publicado|ftp-deploy-sync-state)\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# tipo certo do manifesto (ajuda a instalar o app no celular)
AddType application/manifest+json .webmanifest

# compressão: o index.html (~780 KB) chega ao celular com ~150 KB
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# cache: páginas e service worker sempre conferidos (versão nova chega na hora); imagens guardadas por 1 dia
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|svg)$">
    Header set Cache-Control "max-age=86400"
  </FilesMatch>
</IfModule>
