{
  "name": "WIGO · gestão de obra",
  "short_name": "WIGO",
  "description": "Gestão de obra no celular: presença, produção, RDO, aço, concreto e fotos.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "share_target": {
    "action": "./?compartilhar=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url",
      "files": [{ "name": "arquivos", "accept": ["image/*", "application/pdf", ".pdf", "*/*"] }] }
  },
  "background_color": "#1F3A5F",
  "theme_color": "#1F3A5F",
  "icons": [
    { "src": "icon-wigo-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-wigo-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-wigo-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
